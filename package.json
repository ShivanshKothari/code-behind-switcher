{
  "name": "code-behind-switcher",
  "displayName": "Code-Behind Switcher",
  "publisher": "ShivanshKothari",
  "description": "Switch between markup, code-behind, and ViewModel files (.aspx/.aspx.cs, .xaml/.xaml.cs, .xaml/*ViewModel.cs, .razor/.razor.cs, Angular, C/C++ headers and more) with F7 / Shift+F7. Forked from ncthanh088/view-code-behind",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShivanshKothari/code-behind-switcher"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.viewCode",
        "title": "View Code"
      },
      {
        "command": "extension.viewMarkup",
        "title": "View Markup"
      }
    ],
    "keybindings": [
      {
        "command": "extension.viewCode",
        "key": "F7",
        "when": "editorTextFocus && viewCodeBehind.canViewCode"
      },
      {
        "command": "extension.viewMarkup",
        "key": "Shift+F7",
        "when": "editorTextFocus && viewCodeBehind.canViewMarkup"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.viewCode",
          "when": "viewCodeBehind.canViewCode",
          "group": "navigation"
        },
        {
          "command": "extension.viewMarkup",
          "when": "viewCodeBehind.canViewMarkup",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  }
}
